  "components": {
    "schemas": {
      "Card": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the card"
          },
          "name": {
            "type": "string",
            "description": "Name of the card"
          },
          "supertype": {
            "type": "string",
            "description": "Supertype of the card (e.g., Pokémon, Trainer, Energy)"
          },
          "subtypes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Subtypes of the card"
          },
          "hp": {
            "type": "string",
            "description": "Hit points of the Pokémon"
          },
          "types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Energy types of the card"
          },
          "evolvesFrom": {
            "type": "string",
            "description": "The Pokémon this card evolves from"
          },
          "evolvesTo": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The Pokémon this card evolves to"
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Special rules for the card"
          },
          "attacks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "cost": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "convertedEnergyCost": {
                  "type": "integer"
                },
                "damage": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            },
            "description": "Attacks the Pokémon can perform"
          },
          "weaknesses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            },
            "description": "Weaknesses of the Pokémon"
          },
          "resistances": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            },
            "description": "Resistances of the Pokémon"
          },
          "retreatCost": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Retreat cost of the Pokémon"
          },
          "convertedRetreatCost": {
            "type": "integer",
            "description": "Numeric value of retreat cost"
          },
          "set": {
            "$ref": "#/components/schemas/Set",
            "description": "Set information for the card"
          },
          "number": {
            "type": "string",
            "description": "Card number within the set"
          },
          "artist": {
            "type": "string",
            "description": "Artist who illustrated the card"
          },
          "rarity": {
            "type": "string",
            "description": "Rarity of the card"
          },
          "flavorText": {
            "type": "string",
            "description": "Flavor text on the card"
          },
          "nationalPokedexNumbers": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "National Pokédex numbers"
          },
          "legalities": {
            "type": "object",
            "properties": {
              "unlimited": {
                "type": "string"
              },
              "standard": {
                "type": "string"
              },
              "expanded": {
                "type": "string"
              }
            },
            "description": "Legality of the card in different formats"
          },
          "images": {
            "type": "object",
            "properties": {
              "small": {
                "type": "string",
                "format": "uri"
              },
              "large": {
                "type": "string",
                "format": "uri"
              }
            },
            "description": "Image URLs for the card"
          },
          "tcgplayer": {
            "type": "object",
            "description": "TCGPlayer market information"
          },
          "cardmarket": {
            "type": "object",
            "description": "Cardmarket information"
          }
        }
      },
      "Set": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the set"
          },
          "name": {
            "type": "string",
            "description": "Name of the set"
          },
          "series": {
            "type": "string",
            "description": "Series the set belongs to"
          },
          "printedTotal": {
            "type": "integer",
            "description": "Number of cards printed in the set"
          },
          "total": {
            "type": "integer",
            "description": "Total number of cards in the set including secret rares"
          },
          "legalities": {
            "type": "object",
            "properties": {
              "unlimited": {
                "type": "string"
              },
              "standard": {
                "type": "string"
              },
              "expanded": {
                "type": "string"
              }
            },
            "description": "Legality of the set in different formats"
          },
          "ptcgoCode": {
            "type": "string",
            "description": "PTCGO code for the set"
          },
          "releaseDate": {
            "type": "string",
            "format": "date",
            "description": "Release date of the set"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Last updated timestamp"
          },
          "images": {
            "type": "object",
            "properties": {
              "symbol": {
                "type": "string",
                "format": "uri"
              },
              "logo": {
                "type": "string",
                "format": "uri"
              }
            },
            "description": "Image URLs for the set"
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key",
        "description": "API key for authentication. Register at the Developer Portal for higher rate limits."
      }
    }
  },
