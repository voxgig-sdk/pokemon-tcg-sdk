      op: list: method: *GET
    }
  }

  entity: set: {
    path: "/sets": {
      op: list: method: *GET
    }
    path: "/sets/{id}": {
      op: load: method: *GET
    }
  }

  entity: subtype: {
    path: "/subtypes": {
      op: list: method: *GET
    }
  }

  entity: supertype: {
    path: "/supertypes": {
      op: list: method: *GET
    }
  }

  entity: type: {
    path: "/types": {
      op: list: method: *GET
    }
  }

}