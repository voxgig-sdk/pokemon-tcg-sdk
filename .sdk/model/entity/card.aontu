# Entity: card

main: kit: entity: card: {

  alias: field: {}

  fields: [
    {
      name: "artist"
      req: false
      type: "`$STRING`"
    }
    {
      name: "attacks"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "cardmarket"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "convertedRetreatCost"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "evolvesFrom"
      req: false
      type: "`$STRING`"
    }
    {
      name: "evolvesTo"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "flavorText"
      req: false
      type: "`$STRING`"
    }
    {
      name: "hp"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "images"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "legalities"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "nationalPokedexNumbers"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "number"
      req: false
      type: "`$STRING`"
    }
    {
      name: "rarity"
      req: false
      type: "`$STRING`"
    }
    {
      name: "resistances"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "retreatCost"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "rules"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "set"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "subtypes"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "supertype"
      req: false
      type: "`$STRING`"
    }
    {
      name: "tcgplayer"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "types"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "weaknesses"
      req: false
      type: "`$ARRAY`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "card"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "order_by"
                orig: "order_by"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 250
                kind: "query"
                name: "page_size"
                orig: "page_size"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "q"
                orig: "q"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "select"
                orig: "select"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/cards"
          parts: [
            "cards"
          ]
          select: {
            exist: [
              "order_by"
              "page"
              "page_size"
              "q"
              "select"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/cards/{id}"
          parts: [
            "cards"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
