\"type\":\"string\"},\"tcgplayer\":{\"description\":\"TCGPlayer market information\",\"type\":\"object\"},\"types\":{\"description\":\"Energy types of the card\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"weaknesses\":{\"description\":\"Weaknesses of the Pokémon\",\"items\":{\"properties\":{\"type\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}},\"type\":\"object\"}}},\"description\":\"Successful response with card details\"},\"404\":{\"description\":\"Card not found\"},\"429\":{\"description\":\"Rate limit exceeded\"},\"500\":{\"description\":\"Internal server error\"}},\"security\":[{\"ApiKeyAuth\":[]},{}],\"securitySchemes\":{\"ApiKeyAuth\":{\"description\":\"API key for authentication. Register at the Developer Portal for higher rate limits.\",\"in\":\"header\",\"name\":\"X-Api-Key\",\"type\":\"apiKey\"}},\"securitySource\":\"operation\"}"
            source: "openapi3"
